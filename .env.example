NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_anon_key_here
NEXT_PUBLIC_DEMO_COMPANY_ID=your_company_uuid_here
# Server-only. Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# Server-only encryption secret; use a long random value from your secret manager.
BANK_DATA_ENCRYPTION_KEY=replace_with_a_long_random_secret
# Protected email provider / Edge Function adapter.
EMAIL_DELIVERY_WEBHOOK_URL=https://your-provider.example/send
EMAIL_DELIVERY_WEBHOOK_SECRET=replace_with_provider_secret
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
